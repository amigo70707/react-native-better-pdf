{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["betterpdf"],
  "ios": {
    "iosModuleName": "NitroBetterPdf"
  },
  "android": {
    "androidNamespace": ["betterpdf"],
    "androidCxxLibName": "NitroBetterPdf"
  },
  "autolinking": {
    "BetterPdfView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBetterPdfView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBetterPdfView"
      }
    },
    "BetterPdfCache": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBetterPdfCache"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBetterPdfCache"
      }
    },
    "BetterPdfDocument": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBetterPdfDocument"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBetterPdfDocument"
      }
    }
  },
  "ignorePaths": ["**/node_modules"],
  "gitAttributesGeneratedFlag": true
}
